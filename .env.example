# Copy to .env and set real values. Generate every password with a password manager or `openssl rand -base64 24`.

# --- docker-compose (local development only) ---
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_DB=vetplatform
VET_APP_PASSWORD=
VET_MIGRATOR_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- backend ---
NODE_ENV=development
PORT=3000
# runtime role (subject to row level security)
DATABASE_URL=postgresql://vet_app:<VET_APP_PASSWORD>@127.0.0.1:5432/vetplatform
# owner role, used only by `npm run migrate` and the database tests
MIGRATION_DATABASE_URL=postgresql://vet_migrator:<VET_MIGRATOR_PASSWORD>@127.0.0.1:5432/vetplatform
DB_POOL_MAX=10
CORS_ORIGINS=
TRUST_PROXY=false
